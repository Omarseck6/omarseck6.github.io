# Public values only: NEXT_PUBLIC_* are inlined into the static build. Never put secrets here.
# In GitHub Actions they come from repository variables (Settings → Secrets and variables → Actions → Variables).
NEXT_PUBLIC_SITE_URL=https://omarseck6.github.io
# Form endpoint, e.g. https://formspree.io/f/xxxxxxxx — leave empty to fall back to mailto:
NEXT_PUBLIC_CONTACT_FORM_ENDPOINT=
NEXT_PUBLIC_GA_ID=
